{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Jaspari Studies",
  "theme": "mint",
  "colors": {
    "primary": "#6B3FD4",
    "light": "#9B7EF0",
    "dark": "#4C2A9E"
  },
  "favicon": {
    "light": "/images/android-chrome-192x192.png",
    "dark": "/images/android-chrome-192x192.png"
  },
  "logo": {
    "light": "/images/android-chrome-192x192.png",
    "dark": "/images/android-chrome-192x192.png"
  },
  "navbar": {
    "links": [
      {
        "href": "https://studies.jaspari.com/login",
        "label": "Login"
      },
      {
        "href": "https://studies.jaspari.com/signup",
        "label": "Signup"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Studies",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "getting-started/quickstart"
            ]
          },
          {
            "group": "Studies",
            "pages": [
              "studies/overview",
              "studies/setup-and-launch",
              "studies/pipeline-statuses",
              "studies/auto-scheduling",
              "studies/eligibility-parameters",
              "studies/study-formats",
              "studies/geographic-scope",
              "studies/enrollment-goals",
              "studies/launching-pausing"
            ]
          }
        ]
      },
      {
        "tab": "Sharing",
        "groups": [
          {
            "group": "Sharing",
            "pages": [
              "sharing/account-setup",
              "sharing/collaboration",
              "sharing/sites",
              "sharing/roles-permissions"
            ]
          }
        ]
      },
      {
        "tab": "Billing",
        "groups": [
          {
            "group": "Billing",
            "pages": [
              "billing/pricing",
              "billing/payment-methods",
              "billing/billing-cycles",
              "billing/credits"
            ]
          }
        ]
      },
      {
        "tab": "Compliance",
        "groups": [
          {
            "group": "Trust & Compliance",
            "pages": [
              "compliance/audit-log",
              "compliance/hipaa",
              "compliance/irb-library",
              "compliance/volunteer-data-visibility"
            ]
          }
        ]
      },
      {
        "tab": "Help",
        "groups": [
          {
            "group": "Help",
            "pages": [
              "help/platform-representative",
              "help/technical-support"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {}
  },
  "fonts": {
    "family": "Open Sans"
  },
  "background": {
    "color": {
      "dark": "#131313"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/getting-started/quickstart"
    },
    {
      "source": "/account-setup",
      "destination": "/sharing/account-setup"
    },
    {
      "source": "/organizations/collaboration",
      "destination": "/sharing/collaboration"
    },
    {
      "source": "/organizations/sites",
      "destination": "/sharing/sites"
    },
    {
      "source": "/organizations/roles-permissions",
      "destination": "/sharing/roles-permissions"
    },
    {
      "source": "/support/platform-representative",
      "destination": "/help/platform-representative"
    },
    {
      "source": "/support/technical-support",
      "destination": "/help/technical-support"
    }
  ],
  "contextual": {
    "options": [
      "assistant"
    ],
    "display": "header"
  },
  "api": {
    "playground": {
      "credentials": false
    }
  }
}
